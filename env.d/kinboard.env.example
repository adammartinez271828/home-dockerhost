# Kinboard host settings. Documentation only: compose does NOT read an
# env.d/kinboard.env. The real file is kinboard/upstream/webapp/docker/.env
# (gitignored inside the submodule), seeded from upstream's .env.example.
# Below are the lines this host changes or adds; everything not listed keeps
# upstream's default. Secrets (POSTGRES_PASSWORD, JWT_SECRET, SECRET_KEY_BASE,
# CRON_SECRET, ANON_KEY, SERVICE_ROLE_KEY) are generated by setup.sh.
# See kinboard/README.md.

# Image tag; must match the submodule's checked-out tag (1.7.0 <-> v1.7.0).
KINBOARD_TAG=
# Container timezone (America/New_York).
TZ=
# Bind-mount root for db/ and storage/ (/home/pi/kinboard-data, outside the repo).
DATA_DIR=
# Postgres host port, loopback only (127.0.0.1:5432).
POSTGRES_PORT=
# Kong HTTP host port, loopback only (127.0.0.1:8100).
KONG_HTTP_PORT=
# Kong HTTPS host port, loopback only (127.0.0.1:8543).
KONG_HTTPS_PORT=
# Webapp host port, loopback only (127.0.0.1:3001); Caddy uses the container network instead.
WEBAPP_PORT=
# Public origin, set by `setup.sh --url http://kinboard.local` (also SITE_URL, ADDITIONAL_REDIRECT_URLS).
API_EXTERNAL_URL=
# OpenWeatherMap API key (password manager: "OpenWeatherMap Kinboard dockerhost"); edit by hand, never echo it.
OPENWEATHERMAP_API_KEY=
# Absolute path of the checkout, written by setup.sh (/home/pi/devel/home-dockerhost/kinboard/upstream).
KINBOARD_PROJECT_DIR=
# Required: start.sh uses explicit -f files, so the override must be named here
# ("-f docker-compose.yml -f docker-compose.image.yml -f docker-compose.override.yml").
COMPOSE_FILES=
