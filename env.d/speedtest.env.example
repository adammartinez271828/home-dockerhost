# Speedtest Tracker environment.
# Copy this file to speedtest.env and fill in the REQUIRED values.
# Used by the speedtest service. speedtest.env is gitignored — never commit it.

# REQUIRED. Laravel app key that encrypts stored data. Generate one with:
#   echo "base64:$(openssl rand -base64 32)"
# Paste the whole value INCLUDING the leading "base64:" prefix.
APP_KEY=

# Public URL the dashboard is reached at (must match the Caddy/mDNS name).
# No trailing slash.
APP_URL=http://speedtest.local

# SQLite keeps everything self-contained in ./speedtest/config. Leave as-is
# unless you deliberately want an external DB.
DB_CONNECTION=sqlite

# When to run a speedtest (cron). Every 6h is gentle on the link; while
# actively troubleshooting you may want hourly: "0 * * * *".
SPEEDTEST_SCHEDULE=0 */6 * * *

# Optional: comma-separated Ookla server IDs to pin (otherwise nearest is
# auto-picked each run). Leave blank to auto-select.
SPEEDTEST_SERVERS=

# Drop results older than N days (0 = keep forever).
PRUNE_RESULTS_OLDER_THAN=0

# TZ drives the scheduler; DISPLAY_TIMEZONE drives the dashboard clock.
TZ=America/New_York
DISPLAY_TIMEZONE=America/New_York

# File ownership inside the container — match the host 'pi' user (id -u / id -g).
PUID=1000
PGID=1000
