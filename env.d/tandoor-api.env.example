# Tandoor API access for the Claude Code `add-recipe` skill (.claude/skills/add-recipe/).
# Copy to tandoor-api.env (gitignored) and fill in the token.
# Not used by docker-compose -- this is read by tandoor.py on the machine running the skill.

# Create the token in Tandoor: user menu -> Settings -> API -> Create (scope: read write)
# ---------------------------- REQUIRED -------------------------
TANDOOR_API_TOKEN=
# ---------------------------------------------------------------

# Base URL of the Tandoor instance (default: http://recipes.local)
# TANDOOR_URL=http://recipes.local
