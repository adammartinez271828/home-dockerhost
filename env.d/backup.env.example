# Cloud backup config, read by scripts/db-backup.sh and scripts/db-restore.sh.
# Copy this file to backup.env (gitignored). Nothing here is secret; it lives
# in env.d/ because it is per-host config. See docs/backup-restore.md.

# rclone remote + folder that receives backups (plain files, not encrypted).
# The remote is created by scripts/backup-setup-rclone.sh; the folder is
# created on first upload. "remote:" alone means the Drive root.
RCLONE_REMOTE=gdrive-backup:dockerhost-backups

# Retention on the remote.
#   db/daily/   - one dump per run, deleted after BACKUP_KEEP_DAYS
#   db/monthly/ - the first dump of each month, deleted after BACKUP_KEEP_MONTHLY_DAYS
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MONTHLY_DAYS=400

# Local dumps in backups/ are deleted after this many days.
BACKUP_LOCAL_KEEP_DAYS=7

# Also upload ./mediafiles (recipe images; append-only, never deleted from the
# remote)? 1 = yes, 0 = no.
BACKUP_MEDIA=1
# Also upload env.d/ ? Off by default: those files hold real secrets
# (SECRET_KEY, DB password, API tokens) and the remote is NOT encrypted. They
# are quick to regenerate on a rebuild (see docs/backup-restore.md).
BACKUP_ENV=0

# Also back up Kinboard (kinboard/README.md)? 1 = yes, 0 = no. Its dump goes
# to db/kinboard/ (BACKUP_KEEP_DAYS retention) and its uploads dir to
# storage-kinboard/. Skipped with a warning when kinboard-db is not running.
BACKUP_KINBOARD=1
# Kinboard's Supabase storage bind mount. Default: <DATA_DIR from
# kinboard/upstream/webapp/docker/.env>/storage.
BACKUP_KINBOARD_STORAGE_DIR=

# Optional: a healthchecks.io-style ping URL. GET on success, <url>/fail on
# failure, so a silently-broken nightly backup turns into an alert.
BACKUP_HEALTHCHECK_URL=
