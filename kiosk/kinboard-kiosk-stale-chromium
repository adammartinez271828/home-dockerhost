#!/bin/sh
# Restart the kiosk compositor if the running Chromium binary has been
# replaced on disk (a package upgrade under the live browser). Chromium keeps
# running from the old, unlinked executable, but every new renderer/utility
# process it spawns comes from the new one, and the mismatch crashes tabs
# ("Aw, Snap!"; the 2026-09-19 06:19 152->153 upgrade did this). Called by
# the DPkg::Post-Invoke hook in /etc/apt/apt.conf.d/52kinboard-kiosk after
# every apt run; safe to run by hand. Exit 0 always so apt never fails on it.
#
#   kinboard-kiosk-stale-chromium [--check]     (--check: report only)
set -eu

check_only=0
[ "${1:-}" = --check ] && check_only=1

systemctl is-active --quiet cage@tty1.service || { echo "kinboard-kiosk-stale-chromium: cage@tty1 not active, nothing to do"; exit 0; }

# The browser process is the oldest chromium; /proc/PID/exe grows a
# " (deleted)" suffix once dpkg has unlinked the file it was started from.
pid=$(pgrep -o -x chromium 2>/dev/null || true)
[ -n "$pid" ] || { echo "kinboard-kiosk-stale-chromium: no chromium process"; exit 0; }
exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
case "$exe" in
	*" (deleted)")
		echo "kinboard-kiosk-stale-chromium: chromium pid $pid runs a replaced binary ($exe)"
		if [ "$check_only" = 1 ]; then exit 0; fi
		echo "kinboard-kiosk-stale-chromium: restarting cage@tty1.service"
		systemctl restart cage@tty1.service || true ;;
	*)
		echo "kinboard-kiosk-stale-chromium: chromium pid $pid is current ($exe)" ;;
esac
exit 0
