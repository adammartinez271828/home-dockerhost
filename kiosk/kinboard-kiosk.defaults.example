# /etc/default/kinboard-kiosk -- environment for cage@tty1.service
# (EnvironmentFile=, read by kiosk/kinboard-kiosk). Plain KEY=value lines, no
# quoting needed. kiosk/install.sh copies this file into place only if it is
# absent; edit the live copy on the kiosk and `make kiosk-restart` to apply.

# wlroots output name as printed by wlr-randr (Pi 4 HDMI0 = HDMI-A-1).
KIOSK_OUTPUT=HDMI-A-1

# Portrait rotation: 90 or 270 depending on which way the monitor hangs
# (90 for the kitchen wall as hung on 2026-09-06).
KIOSK_TRANSFORM=90

# Compositor output scale (wlr-randr --scale), i.e. how many physical pixels
# per CSS pixel. Must be an integer. At native 4K: 3 = a 720x1280 layout
# (Kinboard stacks its widgets in one column and fills the height; chosen
# 2026-09-06), 2 = a 1080x1920 two-column layout with an empty band at the
# top. 1 if KIOSK_MODE=1920x1080 is set and the monitor upscales. Fractional
# values and Chromium's --force-device-scale-factor both break under Cage.
KIOSK_SCALE=3

# Optional fixed mode (WIDTHxHEIGHT, or WIDTHxHEIGHT@HZ) passed to wlr-randr.
# Unset = the output's native/preferred mode. Set 1920x1080 if the Pi 4
# struggles compositing Chromium at 4K.
#KIOSK_MODE=1920x1080

# Page to show.
KIOSK_URL=http://kinboard.local/

# Nightly screen-off window, local time (the kiosk is America/New_York, so
# DST is handled), HH:MM. Applied every minute by kinboard-kiosk-screen.timer
# and at compositor start; edits here take effect within a minute, no restart
# needed. Set either one empty to leave the screen always on.
KIOSK_SCREEN_OFF=23:00
KIOSK_SCREEN_ON=06:00

# Wi-Fi reachability watchdog (kinboard-kiosk-net, every minute). Keys on
# reachability, never on NM/iw state: on 2026-09-19 the datapath died while
# every local indicator stayed healthy. Edits take effect on the next tick.

# Interface to ping from (the ping is bound to it; an unbound ping would
# succeed over the diagnostic Ethernet cable and hide the fault) and the
# NetworkManager connection the ladder bounces.
KIOSK_NET_IFACE=wlan0
KIOSK_NET_CONNECTION=netplan-wlan0-bean

# What to ping. Empty = the default gateway on $KIOSK_NET_IFACE, which is the
# right answer: it is one hop away, so a failure means the radio link, not
# the internet.
KIOSK_NET_TARGET=

# A second address pinged and logged in the capture only; it never gates the
# decision (192.168.86.37 = dockerhost, the Pi 5 serving Kinboard).
KIOSK_NET_ALSO=192.168.86.37

# Consecutive failed ticks (= minutes) before the watchdog trips. 5 rides out
# a scan interruption or a brief AP hiccup.
KIOSK_NET_FAILS=5

# Failed bounce cycles (capture + reassociate + down/up, all of which failed)
# before rebooting the Pi. 0 = never reboot, just keep bouncing. At the
# defaults a reboot is roughly 3x(5+1) = 18 min after onset.
KIOSK_NET_MAX_BOUNCES=3

# Evidence log, append-only, rotated weekly x4 by
# /etc/logrotate.d/kinboard-kiosk-net. Written only on transitions, trips and
# captures - never on a quiet tick.
KIOSK_NET_LOG=/var/log/kinboard-kiosk-net.log

# Chromium crash auto-restart (kinboard-kiosk-crash, started by
# kinboard-kiosk-crash.path when a crash dump appears). Restarts past this
# many in a rolling hour are skipped and logged, so a tab that crashes on
# every start cannot restart-loop the browser.
KIOSK_CRASH_MAX_PER_HOUR=3

# One line per crash, append-only; crashes are rare, so no rotation.
KIOSK_CRASH_LOG=/var/log/kinboard-kiosk-crash.log
