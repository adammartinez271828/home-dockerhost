# /etc/default/kinboard-kiosk -- environment for cage@tty1.service
# (EnvironmentFile=, read by kiosk/kinboard-kiosk). Plain KEY=value lines, no
# quoting needed. kiosk/install.sh copies this file into place only if it is
# absent; edit the live copy on the kiosk and `make kiosk-restart` to apply.

# wlroots output name as printed by wlr-randr (Pi 4 HDMI0 = HDMI-A-1).
KIOSK_OUTPUT=HDMI-A-1

# Portrait rotation: 90 or 270 depending on which way the monitor hangs
# (90 for the kitchen wall as hung on 2026-09-06).
KIOSK_TRANSFORM=90

# Compositor output scale (wlr-randr --scale), i.e. how many physical pixels
# per CSS pixel. Must be an integer: 2 at native 4K gives a 1080x1920 layout;
# 1 if KIOSK_MODE=1920x1080 is set and the monitor upscales. Fractional
# values and Chromium's --force-device-scale-factor both break under Cage.
KIOSK_SCALE=2

# Optional fixed mode (WIDTHxHEIGHT, or WIDTHxHEIGHT@HZ) passed to wlr-randr.
# Unset = the output's native/preferred mode. Set 1920x1080 if the Pi 4
# struggles compositing Chromium at 4K.
#KIOSK_MODE=1920x1080

# Page to show.
KIOSK_URL=http://kinboard.local/
