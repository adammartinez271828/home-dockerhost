# Nightly restart of the kiosk compositor (Cage + Chromium), fired by
# kinboard-kiosk-restart.timer inside the screen-off window. Chromium never
# reloads a crashed tab ("Aw, Snap!"); kinboard-kiosk-crash.path restarts on
# a crash dump, and this nightly fresh process is the backstop for anything
# that slips past it (restart cap hit, a crash that writes no dump, slow
# leaks). The wrapper re-applies the screen schedule on start, so a restart
# inside the window stays dark. Installed by kiosk/install.sh.
[Unit]
Description=Nightly restart of the Kinboard kiosk compositor
ConditionPathExists=/usr/local/bin/kinboard-kiosk

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart cage@tty1.service
