#!/bin/sh
# Kiosk wrapper run by cage@tty1.service (kiosk/cage@.service) as user kiosk.
# Rotates the output with wlr-randr, then execs Chromium full-screen on
# Kinboard. POSIX sh: it runs inside the compositor session. Knobs come from
# /etc/default/kinboard-kiosk (see kinboard-kiosk.defaults.example).
set -eu
OUTPUT="${KIOSK_OUTPUT:-HDMI-A-1}"
TRANSFORM="${KIOSK_TRANSFORM:-90}"
SCALE="${KIOSK_SCALE:-3}"
URL="${KIOSK_URL:-http://kinboard.local/}"
# UI scale is applied as the compositor's output scale, not with Chromium's
# --force-device-scale-factor: on Ozone/Wayland the latter makes Chromium tag
# a logical-size buffer with that scale, so the window is drawn at 1/N size.
# Keep it an integer (3 at 4K, chosen on the wall 2026-09-06): Cage 0.2 has no fractional-scale protocol.
if [ -n "${KIOSK_MODE:-}" ]; then
  wlr-randr --output "$OUTPUT" --mode "$KIOSK_MODE" --transform "$TRANSFORM" --scale "$SCALE" || true
else
  wlr-randr --output "$OUTPUT" --transform "$TRANSFORM" --scale "$SCALE" || true
fi
exec chromium \
  --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --ozone-platform=wayland \
  --disable-session-crashed-bubble --disable-features=TranslateUI \
  --check-for-update-interval=31536000 \
  --autoplay-policy=no-user-gesture-required \
  --disable-audio-output \
  --disk-cache-dir="${XDG_RUNTIME_DIR:-/tmp}/chromium-cache" \
  "$URL"
