# Reverse proxy config for LAN services. Plain HTTP only.
#
# The `http://` scheme prefix disables Caddy's automatic HTTPS for the site.
# Caddy preserves the incoming Host header upstream by default.
#
# To add a service: add a block here, then `make caddy-reload`. Also add the
# matching name to mdns-aliases/aliases so it resolves on the LAN.

http://recipes.local {
	reverse_proxy nginx_recipes:80
}

http://smokeping.local {
	# SmokePing's UI lives at /smokeping/smokeping.cgi; send the bare host there.
	redir / /smokeping/smokeping.cgi
	reverse_proxy smokeping:80
}

http://speedtest.local {
	reverse_proxy speedtest:80
}

http://beszel.local {
	# Beszel hub. The UI holds long-lived websocket/SSE streams; upstream's
	# reverse-proxy guidance is a generous read timeout. Caddy proxies
	# websockets without further config.
	reverse_proxy beszel:8090 {
		transport http {
			read_timeout 360s
		}
	}
}

# Kinboard: one origin, split by path. The browser bundle talks to the Supabase
# gateway (Kong) directly, so /rest /auth /storage /realtime go to Kong and
# everything else to the Next.js webapp. Both run in a separate compose project
# (~/kinboard) joined to network_landockernet by kinboard/docker-compose.override.yml.
http://kinboard.local {
	@api path /rest/* /auth/* /storage/* /realtime/*
	reverse_proxy @api kinboard-kong:8000
	reverse_proxy kinboard-webapp:3000
}
