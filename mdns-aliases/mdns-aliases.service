[Unit]
Description=Publish mDNS (.local) aliases for hosted services
Requires=avahi-daemon.service
After=avahi-daemon.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# The script advertises this host's own primary IPv4 by default. Uncomment to
# pin a different address (e.g. a second interface).
# Environment=MDNS_IP=192.168.86.197
# ExecStart is rewritten to this repo's absolute path by `make mdns-install`.
ExecStart=/path/to/repo/mdns-aliases/mdns-aliases.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
